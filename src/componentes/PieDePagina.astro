---
import { navegacion, redes, sitio } from '../datos/sitio';
import { plataformas, alianzas } from '../datos/programa';
import { contacto } from '../datos/contacto';

const anio = new Date().getFullYear();
---

{
  /*
  El pie no es decorativo: acá abajo está el contacto de pauta, que es la
  conversión que le importa al cliente. Por eso el archivo NO usa scroll
  infinito — mataría este bloque.
*/
}
<footer class="border-borde bg-superficie mt-16 border-t" data-pagefind-ignore>
  <div class="contenedor grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-titulo text-lg font-black">
        <span class="text-acento">Noche</span> D10
      </p>
      <p class="text-texto-suave mt-3 max-w-sm text-sm">{sitio.descripcion}</p>

      <a
        href="/anunciantes"
        class="bg-acento-fuerte text-sobre-acento mt-6 inline-block px-5 py-3 text-sm font-semibold hover:opacity-90"
      >
        Anunciá en Noche D10
      </a>
    </div>

    <nav aria-labelledby="pie-secciones">
      <h2
        id="pie-secciones"
        class="text-texto-suave text-xs font-semibold tracking-widest uppercase"
      >
        Secciones
      </h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href} class="hover:text-acento transition-colors">
                {item.texto}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contacto" class="hover:text-acento transition-colors">Contacto</a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="text-texto-suave text-xs font-semibold tracking-widest uppercase">
        Dónde vernos
      </h2>
      <ul class="text-texto-suave mt-3 space-y-1.5 text-sm">
        {plataformas.map((p) => <li>{p.nombre}</li>)}
      </ul>

      <h2 class="text-texto-suave mt-6 text-xs font-semibold tracking-widest uppercase">
        Seguinos
      </h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.href}
                class="hover:text-acento transition-colors"
                rel="noopener me"
              >
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="contenedor border-borde border-t py-6 text-sm">
    <p class="text-texto-suave">
      Trabajamos con{' '}
      {
        alianzas.map((alianza, i) => (
          <>
            {i > 0 && ' y '}
            <strong class="text-texto font-semibold">{alianza.nombre}</strong>
            {alianza.detalle && ` (${alianza.detalle})`}
          </>
        ))
      }.
    </p>
    {
      contacto.correoGeneral ? (
        <p class="mt-2">
          <a href={`mailto:${contacto.correoGeneral}`} class="hover:text-acento">
            {contacto.correoGeneral}
          </a>
        </p>
      ) : (
        /* TODO: dato pendiente del cliente — correo de contacto. */
        <p class="text-texto-suave mt-2">
          <a href="/contacto" class="underline underline-offset-4">
            Escribinos desde la página de contacto
          </a>
        </p>
      )
    }
  </div>

  <div class="border-borde text-texto-suave border-t px-4 py-4 text-center text-xs">
    <p>© {anio} {sitio.nombre} · Producciones D10 · Sitio por Scalerics</p>
  </div>
</footer>
