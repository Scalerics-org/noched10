---
/**
 * Pie (diseño 1e / 1f).
 *
 * No es decorativo: acá abajo está el camino a la pauta, que es la conversión
 * que le importa al cliente. Por eso el archivo NO usa scroll infinito.
 */
import { Image } from 'astro:assets';
import escudo from '../assets/marca/escudo-d10.jpg';
import { navegacion, redes, sitio } from '../datos/sitio';
import { alianzas } from '../datos/programa';
import { direccion } from '../datos/equipo';

const anio = new Date().getFullYear();
const titulo = 'etiqueta text-texto-tenue mb-3.5 text-[0.7rem]';
const enlace = 'text-texto-suave hover:text-texto transition-colors';
---

<footer class="bg-fondo border-borde border-t" data-pagefind-ignore>
  <div class="contenedor pt-12 pb-9 lg:pt-14">
    <div
      class="border-borde grid gap-10 border-b pb-9 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.4fr]"
    >
      <div>
        <p class="mb-4 flex items-center gap-3.5">
          <Image
            src={escudo}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            class="h-11 w-11 object-cover lg:h-14 lg:w-14"
          />
          <span class="placa text-2xl lg:text-3xl">{sitio.nombre}</span>
        </p>
        <p class="text-texto-suave max-w-[40ch] text-[0.85rem] leading-relaxed">
          Tu punto de encuentro con la cultura, el análisis y el entretenimiento. Hace
          16 años, todos los martes.
        </p>
      </div>

      <nav aria-labelledby="pie-programa">
        <h2 id="pie-programa" class={titulo}>El programa</h2>
        <ul class="space-y-1.5 text-[0.85rem]">
          {
            navegacion.map((item) => (
              <li>
                <a href={item.href} class={enlace}>
                  {item.texto}
                </a>
              </li>
            ))
          }
          <li><a href="/contacto" class={enlace}>Contacto</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="pie-redes">
        <h2 id="pie-redes" class={titulo}>Seguinos</h2>
        <ul class="space-y-1.5 text-[0.85rem]">
          {
            redes.map((red) => (
              <li>
                <a href={red.href} class={enlace} rel="noopener me">
                  {red.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class={titulo}>Producción</h2>
        <ul class="text-texto-suave space-y-1 text-[0.85rem] leading-relaxed">
          {
            direccion.map((persona) => (
              <li>
                {persona.rol}: {persona.nombre}
              </li>
            ))
          }
          <li>Producciones D10, Uruguay</li>
        </ul>
        <p class="text-texto-tenue mt-4 text-[0.78rem] leading-relaxed">
          Trabajamos con{' '}
          {
            alianzas.map((alianza, i) => (
              <>
                {i > 0 && ' y '}
                {alianza.nombre}
              </>
            ))
          }.
        </p>
      </div>
    </div>

    <div
      class="text-texto-tenue flex flex-wrap justify-between gap-2 pt-5 text-[0.75rem]"
    >
      <p>© {anio} Producciones D10</p>
      <p>Sitio por Scalerics</p>
    </div>
  </div>
</footer>
