---
/**
 * Toggle grilla ↔ lista.
 *
 * Es preferencia visual pura, así que vive del lado del cliente y se recuerda
 * en localStorage. El estado por defecto lo pinta el servidor, de modo que sin
 * JS el archivo se ve igual y sigue siendo usable: lo único que se pierde es
 * poder cambiarlo.
 */
type Props = { compacta?: boolean };
const { compacta = false } = Astro.props;
const boton =
  'etiqueta text-texto-suave hover:text-texto aria-pressed:bg-acento-fuerte aria-pressed:text-sobre-acento inline-flex min-h-11 items-center gap-2 px-4 text-[0.72rem] tracking-[0.1em] transition-colors';
---

<div data-pagefind-ignore>
  {
    !compacta && (
      <p class="etiqueta text-texto-tenue mb-2.5 text-[0.62rem] tracking-[0.18em]">
        Vista
      </p>
    )
  }
  <div
    class="border-borde flex border"
    role="group"
    aria-label="Forma de ver el archivo"
  >
    <button type="button" data-vista="lista" aria-pressed="true" class={boton}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
      <span class:list={[compacta && 'sr-only']}>Lista</span>
    </button>
    <button
      type="button"
      data-vista="grilla"
      aria-pressed="false"
      class:list={[boton, 'border-borde border-l']}
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        ><rect x="3" y="3" width="7" height="7"></rect><rect
          x="14"
          y="3"
          width="7"
          height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect
          x="14"
          y="14"
          width="7"
          height="7"></rect></svg
      >
      <span class:list={[compacta && 'sr-only']}>Grilla</span>
    </button>
  </div>
</div>

<script>
  const CLAVE = 'noched10:vista-archivo';

  function leer(): string | null {
    try {
      return localStorage.getItem(CLAVE);
    } catch {
      /* Navegación privada o cookies bloqueadas: se sigue con el default. */
      return null;
    }
  }

  function guardar(vista: string) {
    try {
      localStorage.setItem(CLAVE, vista);
    } catch {
      /* Si no se puede guardar, la preferencia dura lo que dura la página. */
    }
  }

  /**
   * El maquetado de las dos vistas está en CSS, colgado de [data-vista]. Acá
   * sólo se cambia el atributo: nada de manotear listas de clases desde JS.
   */
  function aplicar(vista: string) {
    const lista = document.querySelector<HTMLElement>('[data-lista-de-emisiones]');
    if (!lista) return;

    lista.dataset.vista = vista;
    document
      .querySelectorAll<HTMLButtonElement>('button[data-vista]')
      .forEach((boton) => {
        boton.setAttribute('aria-pressed', String(boton.dataset.vista === vista));
      });
  }

  const guardada = leer();
  if (guardada === 'grilla' || guardada === 'lista') aplicar(guardada);

  document
    .querySelectorAll<HTMLButtonElement>('button[data-vista]')
    .forEach((boton) => {
      boton.addEventListener('click', () => {
        const vista = boton.dataset.vista;
        if (!vista) return;
        aplicar(vista);
        guardar(vista);
      });
    });
</script>
