---
import { navegacion, sitio } from '../datos/sitio';
import { textoDeEmision } from '../datos/esquemas';
import CambioDeTema from './CambioDeTema.astro';

const rutaActual = Astro.url.pathname;
const activo = (href: string) =>
  href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
---

{
  /*
  Barra fija de próxima emisión. Va arriba de todo y pegada porque es lo
  primero que alguien viene a buscar: cuándo sale el programa.
*/
}
<div
  class="bg-acento-fuerte text-sobre-acento sticky top-0 z-40 text-center text-sm font-semibold tracking-wide"
>
  <p class="px-4 py-2">
    {textoDeEmision()} ·{' '}
    <a href="/donde-vernos" class="underline underline-offset-4">Dónde vernos</a>
  </p>
</div>

<header class="border-borde bg-fondo/95 sticky top-9 z-30 border-b backdrop-blur">
  <nav
    class="contenedor flex flex-wrap items-center gap-x-6 gap-y-3 py-3"
    aria-label="Principal"
  >
    <a href="/" class="font-titulo mr-auto text-xl font-black tracking-tight">
      <span class="text-acento">Noche</span> D10
      <span class="sr-only">— inicio</span>
    </a>

    <ul
      class="order-3 flex w-full flex-wrap gap-x-5 gap-y-2 text-sm lg:order-none lg:w-auto"
    >
      {
        navegacion.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={activo(item.href) ? 'page' : undefined}
              class="text-texto-suave hover:text-texto aria-[current=page]:text-texto aria-[current=page]:decoration-acento transition-colors aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {item.texto}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/buscar"
      class="text-texto-suave hover:text-texto text-sm transition-colors"
      aria-label="Buscar en el archivo"
    >
      Buscar
    </a>
    <CambioDeTema />
  </nav>
  <span class="sr-only">{sitio.nombre}</span>
</header>
