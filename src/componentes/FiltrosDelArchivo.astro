---
/**
 * Filtros del archivo, por año y por tema.
 *
 * Son LINKS a rutas pre-renderizadas, no un <form> con query params, y eso es
 * a propósito. El sitio es estático: `?anio=2026` no puede cambiar lo que
 * devuelve el servidor porque no hay servidor, así que con JS apagado un form
 * GET recargaría el mismo HTML sin filtrar — o sea, un filtro roto.
 *
 * Con rutas reales el filtro funciona con JS apagado, se puede compartir, se
 * cachea y Google lo indexa, que es justo lo que no hace con query params.
 */
import {
  anios,
  temasConPiezas,
  urlDelArchivo,
  urlDelChip,
  type Filtro,
} from '../datos/archivo';

type Props = { filtro: Filtro };

const { filtro } = Astro.props;

const grupos = [
  {
    titulo: 'Año',
    items: [
      {
        texto: 'Todos',
        activo: !filtro.anio,
        href: urlDelArchivo({ tema: filtro.tema }),
      },
      ...anios.map((anio) => ({
        texto: String(anio),
        activo: filtro.anio === anio,
        href: urlDelChip({ anio }, filtro),
      })),
    ],
  },
  {
    titulo: 'Tema',
    items: [
      {
        texto: 'Todos',
        activo: !filtro.tema,
        href: urlDelArchivo({ anio: filtro.anio }),
      },
      ...temasConPiezas.map((tema) => ({
        texto: tema,
        activo: filtro.tema === tema,
        href: urlDelChip({ tema }, filtro),
      })),
    ],
  },
];
---

<nav
  aria-label="Filtros del archivo"
  class="flex min-w-0 flex-wrap gap-x-6 gap-y-4 max-lg:w-full"
  data-pagefind-ignore
>
  {
    grupos.map((grupo) => (
      <div class="min-w-0 max-lg:w-full">
        <h2 class="etiqueta text-texto-tenue mb-2.5 text-[0.62rem] tracking-[0.18em]">
          {grupo.titulo}
        </h2>
        <ul class="-mx-[var(--gutter)] flex gap-2 overflow-x-auto px-[var(--gutter)] lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0">
          {grupo.items.map((item) => (
            <li class="shrink-0">
              <a
                href={item.href}
                aria-current={item.activo ? 'true' : undefined}
                class="chip"
              >
                {item.texto}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
