---
/**
 * Ficha de una emisión.
 *
 * Una emisión NO es un video: son cuatro piezas (el completo, las entrevistas,
 * el humor y a veces una columna). Esta página las muestra como lo que son,
 * porque si el archivo se navegara como "lista de videos" se pierde toda la
 * navegación entre invitados, temas y segmentos.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import FachadaYoutube from '../../componentes/FachadaYoutube.astro';
import TarjetaPieza from '../../componentes/TarjetaPieza.astro';
import {
  emisionesOrdenadas,
  nombresDeInvitados,
  piezasDe,
} from '../../datos/consultas';
import { urlDeEmision, urlDeInvitado } from '../../datos/archivo';
import { episodio, video } from '../../datos/esquemas';
import { sitio } from '../../datos/sitio';
import { formatearFecha } from '../../datos/texto';

export const getStaticPaths = (async () => {
  const emisiones = await getCollection('emisiones');
  return emisiones.map((emision) => ({
    params: { fecha: emision.data.fecha },
    props: { id: emision.id },
  }));
}) satisfies GetStaticPaths;

const { id } = Astro.props;

const emisiones = await emisionesOrdenadas();
const indice = emisiones.findIndex((e) => e.id === id);
const emision = emisiones[indice];
// Más nueva primero, así "anterior" es la que salió antes en el tiempo.
const siguiente = emisiones[indice - 1];
const anterior = emisiones[indice + 1];

const piezas = await piezasDe(emision);
const nombresDe = await nombresDeInvitados();
const invitados = nombresDe(emision.data.invitados);

const base = Astro.site ?? new URL(sitio.url);
const grafo = [
  episodio({ ...emision.data, invitados }, base),
  ...piezas.map((pieza) =>
    video(
      {
        titulo: pieza.data.titulo,
        resumen: pieza.data.resumen,
        duracion: pieza.data.duracion,
        videoId: pieza.data.videoId,
        fecha: emision.data.fecha,
        invitados: nombresDe(pieza.data.invitados),
      },
      base,
      sitio.imagenOg,
    ),
  ),
];
---

<Base
  titulo={emision.data.titulo}
  descripcion={emision.data.descripcion}
  tipoOg="video.episode"
  grafo={grafo}
  migasDePan={[
    { nombre: 'Programas', ruta: '/programas' },
    { nombre: formatearFecha(emision.data.fecha), ruta: urlDeEmision(emision.data) },
  ]}
>
  <article class="contenedor py-12">
    <p class="text-acento text-xs font-semibold tracking-widest uppercase">
      <time datetime={emision.data.fecha}>{formatearFecha(emision.data.fecha)}</time>
      <span aria-hidden="true"> · </span>{emision.data.duracion}
      {
        emision.data.numero !== null && (
          <>
            <span aria-hidden="true"> · </span>Capítulo {emision.data.numero}
          </>
        )
      }
    </p>

    <h1
      class="font-titulo mt-3 max-w-4xl text-[length:var(--text-titulo)] leading-tight font-black"
    >
      {emision.data.titulo}
    </h1>
    <p class="text-texto-suave mt-4 max-w-2xl">{emision.data.descripcion}</p>

    <div class="mt-8 max-w-4xl">
      <FachadaYoutube
        videoId={emision.data.videoId}
        titulo={`Programa completo: ${emision.data.titulo}`}
        prioridad
      />
    </div>

    {
      invitados.length > 0 && (
        <section class="mt-10" aria-labelledby="invitados">
          <h2
            id="invitados"
            class="text-texto-suave text-xs font-semibold tracking-widest uppercase"
          >
            Invitados de esta emisión
          </h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {invitados.map((nombre) => (
              <li>
                <a
                  href={urlDeInvitado(nombre)}
                  class="border-borde hover:border-acento hover:text-acento block border px-3 py-1.5 text-sm transition-colors"
                >
                  {nombre}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12" aria-labelledby="piezas">
      <h2 id="piezas" class="font-titulo text-[length:var(--text-grande)] font-black">
        Las piezas de este programa
      </h2>
      <p class="text-texto-suave mt-2 max-w-2xl text-sm">
        Cada emisión se publica entera y también partida por segmento, para poder ir
        directo a la entrevista que interesa.
      </p>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          piezas.map((pieza) => (
            <li class="relative">
              <TarjetaPieza
                titulo={pieza.data.titulo}
                tipo={pieza.data.tipo}
                duracion={pieza.data.duracion}
                fecha={emision.data.fecha}
                invitados={nombresDe(pieza.data.invitados)}
                temas={pieza.data.temas}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <nav
      class="border-borde mt-14 flex flex-wrap justify-between gap-4 border-t pt-6"
      aria-label="Otras emisiones"
    >
      {
        anterior ? (
          <a
            href={urlDeEmision(anterior.data)}
            rel="prev"
            class="hover:text-acento max-w-xs"
          >
            <span class="text-texto-suave block text-xs tracking-widest uppercase">
              Emisión anterior
            </span>
            <span class="mt-1 block font-semibold">{anterior.data.titulo}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        siguiente && (
          <a
            href={urlDeEmision(siguiente.data)}
            rel="next"
            class="hover:text-acento max-w-xs text-right sm:ml-auto"
          >
            <span class="text-texto-suave block text-xs tracking-widest uppercase">
              Emisión siguiente
            </span>
            <span class="mt-1 block font-semibold">{siguiente.data.titulo}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
