      {/* TODO: dato pendiente del cliente — logos de los anunciantes actuales. */}
      <ul class="border-borde bg-borde grid grid-cols-3 gap-0.5 border lg:grid-cols-6">
        <li class="bg-fondo grid h-20.5 place-items-center p-2.5 lg:h-26 lg:p-3.5">
