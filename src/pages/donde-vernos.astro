---
import Base from '../layouts/Base.astro';
import { emision, plataformas } from '../datos/programa';
import { redes } from '../datos/sitio';
import { textoDeEmision } from '../datos/esquemas';

const etiquetas: Record<string, string> = {
  radio: 'Radio',
  television: 'Televisión',
  streaming: 'Streaming',
};
---

<Base
  titulo="Dónde vernos"
  descripcion="Noche D10 en radio, televisión abierta, la red de cables del interior y streaming por YouTube."
  migasDePan={[{ nombre: 'Dónde vernos', ruta: '/donde-vernos' }]}
>
  <div class="contenedor py-12">
    <h1 class="font-titulo text-[length:var(--text-titulo)] font-black">
      Dónde vernos y escucharnos
    </h1>
    <p class="mt-4 max-w-2xl text-lg">
      {textoDeEmision()}, de {emision.duracionAprox}.
    </p>
    {
      emision.hora === null && (
        /* TODO: dato pendiente del cliente — horario exacto de emisión.
           El día sale de los estrenos en YouTube (04, 11 y 18 de agosto de
           2026 caen los tres martes); la hora no la sabemos. */
        <p class="text-texto-suave mt-2 max-w-2xl text-sm">
          El horario exacto lo estamos confirmando.
        </p>
      )
    }

    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        plataformas.map((plataforma) => (
          <li class="border-borde bg-superficie border p-6">
            <p class="text-acento text-xs font-semibold tracking-widest uppercase">
              {etiquetas[plataforma.tipo] ?? plataforma.tipo}
            </p>
            <h2 class="mt-2 text-lg font-semibold">{plataforma.nombre}</h2>
            <p class="text-texto-suave mt-1 text-sm">{plataforma.detalle}</p>
            {plataforma.href && (
              <p class="mt-4">
                <a
                  href={plataforma.href}
                  rel="noopener"
                  class="text-acento text-sm underline underline-offset-4"
                >
                  Ir a {plataforma.nombre}
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>

    {
      /* TODO: dato pendiente del cliente — la lista de canales de cable del
        interior con su localidad y su número de señal. Es exactamente lo que
        busca alguien del interior que quiere ver el programa. */
    }
    <p class="border-borde mt-8 max-w-2xl border-l-4 p-4 text-sm">
      Estamos armando la grilla completa de canales de cable del interior, con la
      localidad y el número de señal de cada uno.
    </p>

    <section class="mt-14" aria-labelledby="redes">
      <h2 id="redes" class="font-titulo text-[length:var(--text-grande)] font-black">
        Seguinos
      </h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          redes.map((red) => (
            <li>
              <a
                href={red.href}
                rel="noopener me"
                class="border-borde hover:border-acento hover:text-acento block border px-4 py-2 text-sm transition-colors"
              >
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
