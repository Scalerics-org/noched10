---
/**
 * Ficha de una pieza.
 *
 * La ruta es /entrevistas/ para todas las piezas, incluidas las de humor, las
 * columnas y las musicales, porque en este programa todo segmento se arma
 * alrededor de un invitado: "Las Humoradas de Luis Orpi" sale con Sergio Sosa,
 * la columna de tenencia compartida con Raúl Menéndez, la musical con la
 * Sonora Palacio. El tipo de pieza se muestra arriba del título.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';

import Base from '../../layouts/Base.astro';
import FachadaYoutube from '../../componentes/FachadaYoutube.astro';
import TarjetaPieza from '../../componentes/TarjetaPieza.astro';
import { nombresDeInvitados, piezasDe } from '../../datos/consultas';
import { urlDeEmision, urlDeInvitado, urlDelArchivo } from '../../datos/archivo';
import { video } from '../../datos/esquemas';
import { sitio } from '../../datos/sitio';
import { formatearFecha } from '../../datos/texto';

export const getStaticPaths = (async () => {
  const piezas = await getCollection('piezas');
  return piezas.map((pieza) => ({
    params: { slug: pieza.id },
    props: { id: pieza.id },
  }));
}) satisfies GetStaticPaths;

const { id } = Astro.props;

const pieza = (await getEntry('piezas', id))!;
const emision = (await getEntry(pieza.data.emision))!;

const nombresDe = await nombresDeInvitados();
const invitados = nombresDe(pieza.data.invitados);

// El resto del programa, para que la ficha no sea un callejón sin salida.
const hermanas = (await piezasDe(emision)).filter((otra) => otra.id !== pieza.id);

const etiquetas: Record<string, string> = {
  entrevista: 'Entrevista',
  humor: 'Segmento de humor',
  columna: 'Columna',
  musica: 'Música en vivo',
};

const base = Astro.site ?? new URL(sitio.url);
const grafo = [
  video(
    {
      titulo: pieza.data.titulo,
      resumen: pieza.data.resumen,
      duracion: pieza.data.duracion,
      videoId: pieza.data.videoId,
      fecha: emision.data.fecha,
      invitados,
    },
    base,
    sitio.imagenOg,
  ),
];
---

<Base
  titulo={pieza.data.titulo}
  descripcion={pieza.data.resumen}
  tipoOg="video.episode"
  grafo={grafo}
  migasDePan={[
    { nombre: 'Programas', ruta: '/programas' },
    { nombre: formatearFecha(emision.data.fecha), ruta: urlDeEmision(emision.data) },
    { nombre: pieza.data.titulo, ruta: `/entrevistas/${pieza.id}` },
  ]}
>
  <article class="contenedor py-12">
    <p class="text-acento text-xs font-semibold tracking-widest uppercase">
      {etiquetas[pieza.data.tipo] ?? pieza.data.tipo}
      <span aria-hidden="true"> · </span>{pieza.data.duracion}
    </p>

    <h1
      class="font-titulo mt-3 max-w-4xl text-[length:var(--text-titulo)] leading-tight font-black"
    >
      {pieza.data.titulo}
    </h1>

    <p class="text-texto-suave mt-4">
      De la emisión del{' '}
      <a
        href={urlDeEmision(emision.data)}
        class="text-acento underline underline-offset-4"
      >
        <time datetime={emision.data.fecha}>{formatearFecha(emision.data.fecha)}</time>
      </a>
    </p>

    <div class="mt-8 max-w-4xl">
      <FachadaYoutube
        videoId={pieza.data.videoId}
        titulo={pieza.data.titulo}
        prioridad
      />
    </div>

    <p class="mt-6 max-w-2xl">{pieza.data.resumen}</p>

    <div class="mt-10 flex flex-wrap gap-8">
      {
        invitados.length > 0 && (
          <section aria-labelledby="con">
            <h2
              id="con"
              class="text-texto-suave text-xs font-semibold tracking-widest uppercase"
            >
              Con
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {invitados.map((nombre) => (
                <li>
                  <a
                    href={urlDeInvitado(nombre)}
                    class="border-borde hover:border-acento hover:text-acento block border px-3 py-1.5 text-sm transition-colors"
                  >
                    {nombre}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        pieza.data.temas.length > 0 && (
          <section aria-labelledby="temas">
            <h2
              id="temas"
              class="text-texto-suave text-xs font-semibold tracking-widest uppercase"
            >
              Temas
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {pieza.data.temas.map((tema) => (
                <li>
                  <a
                    href={urlDelArchivo({ tema })}
                    class="border-borde hover:border-acento hover:text-acento block border px-3 py-1.5 text-sm capitalize transition-colors"
                  >
                    {tema}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {
      hermanas.length > 0 && (
        <section class="mt-14" aria-labelledby="resto">
          <h2
            id="resto"
            class="font-titulo text-[length:var(--text-grande)] font-black"
          >
            El resto de ese programa
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {hermanas.map((otra) => (
              <li class="relative">
                <TarjetaPieza
                  titulo={otra.data.titulo}
                  tipo={otra.data.tipo}
                  duracion={otra.data.duracion}
                  fecha={emision.data.fecha}
                  invitados={nombresDe(otra.data.invitados)}
                  temas={otra.data.temas}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
